[Unit]
Description=WeType 跨设备剪贴板同步（wxclipd）
Documentation=https://github.com/mkdir700/wx-ime-sdk
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/wxclipd run
Restart=on-failure
RestartSec=5
Environment=RUST_BACKTRACE=1

[Install]
WantedBy=graphical-session.target
